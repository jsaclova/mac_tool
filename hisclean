#!/bin/bash
# ===============================================
# Name: hisclean
# Author: Jin (jsaclova@gmail.com)
# Date: 2026-09-23
# Description: Terminal Command History Permanent Eraser (Zsh Memory Wiping Fixed)
# ===============================================

clear
echo "============================================================"
echo " ▶️ Program     : hisclean"
echo " ▶️ Author      : Jin (jsaclova@gmail.com)"
echo " ▶️ Description : Terminal Command History Permanent Eraser"
echo "============================================================"
echo "  This tool permanently wipes out all your terminal command"
echo "  history from both the active memory and the history file."
echo "============================================================"
echo ""

echo " 🔥 WARNING: This action will destroy all command history logs."
echo " 📋 Select an option:"
echo "------------------------------------------------------------"
echo "   [1] Proceed with permanent history wiping"
echo "   [0] Exit and Cancel (Return to local Mac terminal)"
echo "------------------------------------------------------------"
read -p "👉 Enter option number: " OPTION
echo "------------------------------------------------------------"

case "$OPTION" in
    1)
        echo " 🧼 Step 1: Killing physical history databases from disk..."
        # 디스크에 안전하게 적재되어 있던 물리 아카이브 파일 영구 격파
        rm -f "$HOME/.zsh_history" 2>/dev/null
        rm -f "$HOME/.bash_history" 2>/dev/null
        
        echo " 🧼 Step 2: Wiping active Zsh session memory buffer..."
        # [핵심 패치] Zsh 셸 내부의 세션 링 버퍼 및 히스토리 스택을 즉시 폭파하여 롤백 방지
        history -c 2>/dev/null
        if [ -n "$ZSH_VERSION" ]; then
            # Zsh 환경일 경우 메모리 공간을 강제로 빈 컨텍스트로 전환하여 잔재 소멸
            fc -p /dev/null 2>/dev/null
        fi
        
        echo " 🧼 Step 3: Re-mapping safe clean database checkpoint..."
        # 다음 부팅 시 시스템 충돌을 막기 위해 무결한 공백 파일 재안착
        touch "$HOME/.zsh_history" 2>/dev/null
        
        echo "------------------------------------------------------------"
        echo " ✨ Success! Command history has been wiped out completely."
        echo " 💡 Wiped out instantly! Even if you type 'history' right now,"
        echo "    all past traces are completely gone."
        echo "============================================================"
        ;;
    0|q|quit|exit|"")
        echo " 🚪 Cancelled. Safely returned to Mac terminal."
        echo "============================================================"
        exit 0
        ;;
    *)
        echo "❌ Error: Invalid option selected. Canceling process."
        echo "============================================================"
        exit 1
        ;;
esac
